# URL of your actual-server instance
ACTUAL_SERVER_URL=https://actual.example.com

# Server password (the one you use to log into the web UI)
ACTUAL_PASSWORD=changeme

# Settings -> Show advanced settings -> Sync ID
ACTUAL_BUDGET_SYNC_ID=00000000-0000-0000-0000-000000000000

# Local cache directory for the downloaded budget (created if missing)
ACTUAL_DATA_DIR=./.actual-data

# Only set if your budget file uses end-to-end encryption
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# Write tools are disabled unless this is exactly "true"
ACTUAL_ENABLE_WRITE=false
